{
  "expo": {
    "name": "SkyGo",
    "slug": "skygo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skygomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.skygo.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "SkyGo kết nối tới máy chủ SkyGo trong mạng nội bộ khi bạn chạy bản thử nghiệm."
      }
    },
    "android": {
      "versionCode": 21,
      "adaptiveIcon": {
        "backgroundColor": "#0894AE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.skygo.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0894AE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "SkyGo cần truy cập ảnh để bạn chọn ảnh đại diện và gửi ảnh cho bộ phận hỗ trợ.",
          "cameraPermission": "SkyGo cần dùng máy ảnh để bạn chụp ảnh đại diện và gửi ảnh cho bộ phận hỗ trợ.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SkyGo cần truy cập ảnh để lưu vé điện tử vào thư viện của bạn.",
          "savePhotosPermission": "SkyGo cần quyền lưu ảnh vé điện tử vào thư viện của bạn.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0894AE",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkyGo dùng vị trí của bạn để gợi ý sân bay gần nhất. Vị trí chỉ được tính trên máy và không gửi lên máy chủ."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3dc9ac51-7f82-4ed0-a687-eb352b22e353"
      }
    },
    "owner": "sky-go"
  }
}
