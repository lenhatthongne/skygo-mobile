# Base URL of the SkyGo backend API (including /api). Not a secret.
# Defaults when unset: Android emulator http://10.0.2.2:8080/api, iOS simulator and web http://localhost:8080/api.
# A physical phone needs the LAN address of the machine running the backend:
#   run `scripts/use-lan-api.sh` here and `scripts/run-dev.sh --lan` in skygo-backend.
# Release builds must use an https URL (the HTTP allowances in app.json are for demos only).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ANDROID_API_URL=
EXPO_PUBLIC_IOS_API_URL=

# Optional local AI demo. Put these in .env.local and restart Expo.
EXPO_PUBLIC_ENABLE_FLIGHT_AI=false
# Server only. Never use EXPO_PUBLIC_ for this key.
GEMINI_API_KEY=

